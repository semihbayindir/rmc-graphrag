# Do not put comments at the end of a value line; they are read as part of the value.

# =============================================================================
# Required
# =============================================================================

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Set before the first start. Neo4j stores it when the database volume is created.
NEO4J_V2_PASSWORD=

# =============================================================================
# Optional: model settings (defaults shown)
# =============================================================================

# Query rewriting, routing and answer generation
OPENAI_MODEL=gpt-5.4-mini

# Answer generation model. Empty uses OPENAI_MODEL.
OPENAI_SYNTH_MODEL=

# Comma-separated models selectable in the chat UI. Empty hides the selector.
OPENAI_SYNTH_MODEL_CHOICES=gpt-5.4-mini,gpt-4o-mini,gpt-5.4-nano

# none | low | medium | high. Temperature is applied only with none.
OPENAI_REASONING_EFFORT=none

# Must match the embeddings stored in the database dump.
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=768

OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=4

# =============================================================================
# ETL and evaluation scripts only (not used by the running services)
# =============================================================================

# Neo4j connection for scripts run on the host
NEO4J_V2_URI=bolt://localhost:7687
NEO4J_V2_USERNAME=neo4j
NEO4J_V2_DATABASE=neo4j

# Ticket extraction model. Empty uses OPENAI_MODEL.
OPENAI_ETL_MODEL=
OPENAI_ETL_REASONING_EFFORT=low

# Evaluation judge model
OPENAI_JUDGE_MODEL=gpt-5.5
OPENAI_JUDGE_REASONING_EFFORT=low

# Shared OpenAI request limit per minute across ETL workers
OPENAI_RPM=500

# Zendesk instance: https://<subdomain>.zendesk.com
ZENDESK_SUBDOMAIN=euromsg

# OAuth client credentials. The scope must be exactly "read";
# granular scopes return a token without permissions.
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_SCOPE=read

# Comma-separated group names, exactly as in Zendesk
ZENDESK_TECH_GROUPS=Teknik Destek,Ar-Ge

# Comma-separated user IDs of former agents to include
ZENDESK_EXTRA_AGENT_IDS=

ZENDESK_MONTHS_BACK=18
ZENDESK_RPM=60
ZENDESK_RAW_DIR=data/raw
ZENDESK_NORM_DIR=data/normalized
